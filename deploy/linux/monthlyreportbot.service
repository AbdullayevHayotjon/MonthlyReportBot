[Unit]
Description=MonthlyReportBot Telegram worker
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=monthlyreportbot
Group=monthlyreportbot
WorkingDirectory=/opt/monthlyreportbot/current
ExecStart=/opt/monthlyreportbot/current/MonthlyReportBot
EnvironmentFile=/etc/monthlyreportbot/bot.env
Environment=Bot__StorageRoot=/var/lib/monthlyreportbot
Environment="Bot__ConnectionString=Data Source=/var/lib/monthlyreportbot/bot.db;Default Timeout=30;Foreign Keys=True"
Environment=Bot__HealthFile=/run/monthlyreportbot/healthy
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1
Environment=DOTNET_ENVIRONMENT=Production
Restart=on-failure
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=90
CPUQuota=100%
MemoryHigh=512M
MemoryMax=1G
RuntimeDirectory=monthlyreportbot
RuntimeDirectoryMode=0750
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/monthlyreportbot /run/monthlyreportbot

[Install]
WantedBy=multi-user.target
